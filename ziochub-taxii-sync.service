[Unit]
Description=ZIoCHub TAXII Sync - Pull IOCs from remote TAXII 2.1 server
After=network.target

[Service]
Type=oneshot
User=ziochub
Group=ziochub
WorkingDirectory=/opt/ziochub
ExecStart=/opt/ziochub/venv/bin/python /opt/ziochub/taxii_sync_job.py
EnvironmentFile=-/opt/ziochub/data/ziochub.env
Environment="PATH=/opt/ziochub/venv/bin:/usr/bin:/bin"

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ziochub/data
ProtectHome=true
