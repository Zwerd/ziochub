[Unit]
Description=ZIoCHub IOC Manager
After=network.target

[Service]
Type=simple
User=ziochub
Group=ziochub
WorkingDirectory=/opt/ziochub
ExecStart=/bin/bash /opt/ziochub/start.sh
Restart=always
RestartSec=5
EnvironmentFile=-/opt/ziochub/data/ziochub.env
Environment="PATH=/opt/ziochub/venv/bin:/usr/bin:/bin"
# Pull sync via systemd timers (ziochub-misp-sync / ziochub-taxii-sync), not in each Gunicorn worker.
Environment="ZIOCHUB_USE_SYSTEMD_SYNC=1"
# Extra headroom when health-check probes tie up workers (override in ziochub.env).
Environment="ZIOCHUB_WORKERS=5"

# Hardening (service runs as ziochub; data dir writable)
NoNewPrivileges=true
ReadWritePaths=/opt/ziochub/data
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
